{
  "name": "panda-toolbox",
  "version": "5.3.3",
  "description": "Panda-Toolbox",
  "main": "src/js/main.js",
  "author": "PANDA",
  "publisher": "ProGamer-Panda",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "webhook": "node xpay-webhook-server.js",
    "start:webhook": "node xpay-webhook-server.js",
    "poller": "node server/poller.js",
    "clean": "taskkill /F /IM electron.exe /T 2>nul || exit 0",
    "clean-dist": "rimraf dist",
    "build": "npm run clean-dist && npm run clean && electron-builder --win",
    "build:prod": "npm run clean-dist && npm run clean && node build.js",
    "build-icon": "electron-icon-builder --input=./src/icon.png --output=build --flatten"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pg0panda/panda-app.git"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "follow-redirects": "^1.15.11",
    "groq-sdk": "^1.2.0",
    "node-fetch": "^2.7.0",
    "node-machine-id": "^1.1.12",
    "systeminformation": "^5.33.1"
    ,"express": "^4.18.2",
    "body-parser": "^1.20.2",
    "nodemailer": "^6.9.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^25.9.8",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^13.0.1"
  },
  "build": {
    "appId": "com.pg.panda.toolbox",
    "productName": "Panda-Toolbox",
    "artifactName": "panda-Toolbox-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "src"
    },
    "files": [
      "src/**/*",
      "src/.env.encrypted",
      "src/encrypted-tools/**",
      "src/html/**",
      "src/js/preload.js",
      "src/sound-image/app.ico",
      "src/sound-image/**",
      "src/app.manifest",
      "src/knowledge.txt",
      "encrypt_tools.js",
      "!native-src/**",
      "!binding.gyp",
      "!build/binding.sln",
      "!build/*.vcxproj*",
      "!build/Release/*.obj",
      "!build/Release/*.lib",
      "!build/Release/*.exp"
    ],
    "extraResources": [
  {
    "from": "build/Release/panda_secure_addon.node",
    "to": "panda_secure_addon.node"
  }
],
    "publish": {
      "provider": "github",
      "owner": "pg0panda",
      "repo": "panda-app",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/sound-image/app.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signtoolOptions": {
        "publisherName": "ProGamer-Panda"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Panda Toolbox",
      "uninstallDisplayName": "Panda-Toolbox (إزالة التثبيت)",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    }
  }
}
